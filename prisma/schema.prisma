generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  name               String?
  plan               String        @default("free")
  stripeCustomerId   String?       @unique
  stripeSubscriptionId String?     @unique
  subscriptionStatus String        @default("inactive")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  businesses         Business[]
  sessions           Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id             String           @id @default(cuid())
  userId         String?
  name           String
  domain         String           @unique
  url            String
  industry       String?
  city           String?
  country        String?
  description    String?
  facts          Json?
  score          Int              @default(0)
  monitoring     Boolean          @default(false)
  monitorEveryHours Int           @default(24)
  nextMonitorAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  scans          Scan[]
  opportunities  Opportunity[]
  promptRuns     PromptRun[]
  actions        Action[]
  connectors     Connector[]
  monitoredQueries MonitoredQuery[]
  competitors    Competitor[]
  monitoringRuns MonitoringRun[]
  @@index([userId])
  @@index([monitoring, nextMonitorAt])
}

model Scan {
  id          String   @id @default(cuid())
  businessId  String
  status      String   @default("completed")
  score       Int
  result      Json
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, createdAt])
}

model Opportunity {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  description String
  category    String
  priority    String
  impact      Int
  effort      Int
  status      String   @default("open")
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actions     Action[]
  @@index([businessId, status])
}

model PromptRun {
  id             String   @id @default(cuid())
  businessId     String
  engine         String
  query          String
  response       String?
  brandMentioned Boolean  @default(false)
  position       Int?
  citations      Json?
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, createdAt])
}

model Connector {
  id             String   @id @default(cuid())
  businessId     String
  type           String
  label          String
  baseUrl        String
  credentialsEncrypted String
  status         String   @default("connected")
  lastCheckedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, type])
}

model Action {
  id             String       @id @default(cuid())
  businessId     String
  opportunityId  String?
  type           String
  title          String
  description    String
  status         String       @default("proposed")
  payload        Json
  beforeSnapshot Json?
  afterSnapshot  Json?
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  appliedAt      DateTime?
  rolledBackAt   DateTime?
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  events         ActionEvent[]
  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model ActionEvent {
  id        String   @id @default(cuid())
  actionId  String
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  @@index([actionId, createdAt])
}

model MonitoredQuery {
  id             String   @id @default(cuid())
  businessId     String
  query          String
  provider       String   @default("unconfigured")
  active         Boolean  @default(true)
  lastRunAt      DateTime?
  lastMentioned  Boolean  @default(false)
  lastPosition   Int?
  lastResponse   String?
  lastCitations  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, query])
  @@index([businessId, active])
}

model Competitor {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  domain      String
  score       Int?
  notes       String?
  lastScannedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, domain])
}

model MonitoringRun {
  id          String   @id @default(cuid())
  businessId  String
  status      String   @default("running")
  previousScore Int?
  newScore    Int?
  delta       Int?
  summary     String?
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, startedAt])
}
